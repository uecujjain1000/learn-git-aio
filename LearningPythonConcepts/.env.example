# .env.example
# -----------------------------------------------------------------------------
# This is a TEMPLATE for the real .env file.
# Copy this file to '.env' and fill in actual values.
# The real .env is git-ignored so secrets never get committed.
#
# How variables here get read:
#   - python-dotenv loads them into os.environ when the app starts
#   - config/config.py then reads os.environ to get the values
# -----------------------------------------------------------------------------

# Run mode: True turns on detailed logs and debug behavior
DEBUG=True

# Greeting shown in the app
APP_USER_NAME=Learner

# A fake API key just to show how secrets would be stored
API_KEY=replace_me_with_a_real_key
