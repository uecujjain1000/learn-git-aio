while True:
    print("Please enter the number (or 'exit' to quit)")
    user_input = input("")

    if user_input == "exit":
        break

    number = int(user_input)
    if number % 5 == 0 and number % 3 == 0:
        print("Zoom")
    elif number % 3 == 0:
        print("Zip")
    elif number % 5 == 0:
        print("Zap")
    else:
        print("Invalid")
